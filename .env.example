# ==============================================================================
# BalanceVault Environment Configuration Template
#
# Instructions:
# 1. Copy this file to '.env' in the project root:
#      Copy-Item .env.example .env
# 2. Replace placeholder values with your actual local credentials.
# 3. Do NOT commit the '.env' file containing real secrets to version control.
# ==============================================================================

# PostgreSQL Database Configuration
# Default URL connects to localhost PostgreSQL. Adjust database name as needed.
DB_URL=jdbc:postgresql://localhost:5432/ledgerline_db
DB_USERNAME=ledgerline_app
DB_PASSWORD=your_postgres_password_here

# JWT Security Configuration
# Must be at least 256 bits (32 bytes / 32 characters in UTF-8)
JWT_SECRET=your_secure_random_jwt_secret_at_least_32_characters_here
JWT_EXPIRATION_MS=86400000

# Server HTTP Port
PORT=8081

